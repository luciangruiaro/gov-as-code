# .env.example: copy to .env (gitignored) and fill in. Same order as the sections in workspace.toml.
# Secrets live only here, on each person's machine. Never on the shared drive, never in Git.

# --- Backlog mirror (tools/mirrors/backlog.py; workspace.toml [backlog]) --------------------------------------------
# Jira (Server/Data Center: a personal access token; Cloud: your account email plus an API token)
JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=
# Azure DevOps (when [backlog] system = "ado")
ADO_ORG_URL=https://dev.azure.com/<org>
ADO_PAT=
ADO_TEAM=

# --- In-app feedback mirror (tools/mirrors/feedback.py; workspace.toml [feedback]) ------------------------------------
# A READ-ONLY database user on the app's feedback table or view.
FEEDBACK_DB_URL=postgresql://readonly:<password>@<host>:5432/<db>

# --- Daily digest (tools/reporting/digest.py and the gov-digest skill; workspace.toml [digest]) ----------------------
# Incoming webhooks of the team chat spaces (Google Chat, Slack or Teams).
CHAT_WEBHOOK_NOTIFICATIONS=
CHAT_WEBHOOK_DISCUSSION=
CHAT_WEBHOOK_TEST=
# Off by default: the digest waits for a person to approve each draft.
DIGEST_AUTO_SEND=false
