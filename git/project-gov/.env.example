# .env.example: copy to .env (gitignored) and fill in. Same order as the sections in workspace.toml.
# Secrets live only here, on each person's machine. Never on the shared drive, never in Git.

# --- Backlog mirror (tools/mirrors/backlog.py; workspace.toml [backlog]) --------------------------------------------
# Jira (Server/Data Center: a personal access token; Cloud: your account email plus an API token)
JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=
# Azure DevOps (when [backlog] system = "ado")
ADO_ORG_URL=https://dev.azure.com/<org>
ADO_PAT=
ADO_TEAM=

# --- In-app feedback mirror (tools/mirrors/feedback.py; workspace.toml [feedback]) ------------------------------------
# A READ-ONLY database user on the app's feedback table or view.
FEEDBACK_DB_URL=postgresql://readonly:<password>@<host>:5432/<db>

# --- Team chat (tools/reporting/chat.py; the gov-chat and gov-digest skills; operations/README.md) -------------------
# Incoming webhooks of the chat spaces. Google Chat: open the space > Apps & integrations > Webhooks > Add webhook,
# then paste the whole URL. Slack's incoming webhooks work too. Older GCHAT_WEBHOOK_* names are also read.
# TEST: the sandbox · NOTIFICATIONS: automated posts and the workspace update · DISCUSSION: the team's room.
CHAT_WEBHOOK_TEST=
CHAT_WEBHOOK_NOTIFICATIONS=
CHAT_WEBHOOK_DISCUSSION=
# The names that sign messages. BOT: automated posts (empty means "<project name> bot"). ARCHITECT: posts made for the
# design authority. Older GCHAT_PERSONA_* names are also read.
CHAT_PERSONA_BOT=
CHAT_PERSONA_ARCHITECT=

# --- The workspace update (tools/reporting/digest.py and the gov-digest skill; workspace.toml [digest]) -------------
# Off by default: the update waits for a person to approve each draft. true lets it post at once (scheduled runs).
DIGEST_AUTO_SEND=false
