# IDE and OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Office lock files on the shared half
~$*

# Python
__pycache__/
*.pyc
.pytest_cache/

# Secrets never enter Git
.env

# Product repos cloned beside the gov repo are repositories of their own
/git/*
!/git/README.md
!/git/project-gov/
# DevTalks demo: Hello World's three repositories, kept here as plain folders (git/README.md)
!/git/project-db/
!/git/project-be/
!/git/project-fe/

# Node and build output
node_modules/
dist/

# Claude Code's local folders: skill links made by tools/skills/link.py, GitNexus's installed skills, settings
/.claude/
/git/project-gov/.claude/

# Code graphs: local snapshots, refreshed by git/project-gov/tools/repos/scan.py
graphify-out/
.gitnexus/
